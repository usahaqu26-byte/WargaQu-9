{
  "entities": {
    "AccountRegistry": {
      "title": "AccountRegistry",
      "description": "Lightweight hybrid citizen metadata and module usage summary (~0.5-1 KB per account).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID owning this account metadata."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "Verified account email."
        },
        "displayName": {
          "type": "string",
          "maxLength": 80,
          "description": "Display name shown in Admin governance view."
        },
        "phone": {
          "type": "string",
          "maxLength": 32,
          "description": "Citizen WhatsApp or phone number."
        },
        "deviceMask": {
          "type": "string",
          "maxLength": 48,
          "description": "Masked device fingerprint."
        },
        "activeModules": {
          "type": "array",
          "description": "Bounded list (max 8) of active WargaQu module IDs used on this account."
        },
        "trahNames": {
          "type": "array",
          "description": "Bounded list (max 15) of Trah names joined by this account."
        },
        "communityNames": {
          "type": "array",
          "description": "Bounded list (max 15) of RT/Paguyuban names joined by this account."
        },
        "activeScreen": {
          "type": "string",
          "maxLength": 40,
          "description": "Last active module screen."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when account metadata was created."
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest login or module activity."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "phone",
        "deviceMask",
        "activeModules",
        "trahNames",
        "communityNames",
        "activeScreen",
        "createdAt",
        "lastSeenAt"
      ]
    },
    "AccountPolicy": {
      "title": "AccountPolicy",
      "description": "Admin moderation and VIP Free access override for a specific account.",
      "type": "object",
      "properties": {
        "targetEmail": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "Normalized lowercase target account email."
        },
        "phone": {
          "type": "string",
          "maxLength": 32,
          "description": "Optional target phone number."
        },
        "status": {
          "type": "string",
          "enum": ["normal", "free", "warning", "banned"],
          "description": "Account access status enforced across devices."
        },
        "freeModules": {
          "type": "array",
          "description": "Bounded list (max 6) of monetizable module IDs granted free when allModulesFree is false."
        },
        "allModulesFree": {
          "type": "boolean",
          "description": "True if all monetizable modules are free for this account."
        },
        "note": {
          "type": "string",
          "maxLength": 300,
          "description": "Moderation warning or ban reason shown to user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when policy was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when policy was updated."
        },
        "updatedByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Admin UID who modified this policy."
        }
      },
      "required": [
        "targetEmail",
        "phone",
        "status",
        "freeModules",
        "allModulesFree",
        "note",
        "createdAt",
        "updatedAt",
        "updatedByUid"
      ]
    },
    "GovernanceConfig": {
      "title": "GovernanceConfig",
      "description": "Shared non-PII community free rules (Trah / RT / Paguyuban).",
      "type": "object",
      "properties": {
        "communityFreeRules": {
          "type": "array",
          "description": "Bounded list (max 50) of community free modular rules."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        },
        "updatedByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Admin UID who updated governance config."
        }
      },
      "required": ["communityFreeRules", "updatedAt", "updatedByUid"]
    },
    "MonetizationConfig": {
      "title": "MonetizationConfig",
      "description": "Shared non-PII modular monetization toggles and fee configuration.",
      "type": "object",
      "properties": {
        "rules": {
          "type": "array",
          "description": "Bounded list (max 10) of module monetization rules."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of latest update."
        },
        "updatedByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Admin UID who updated monetization config."
        }
      },
      "required": ["rules", "updatedAt", "updatedByUid"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Admin role assignment document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Admin Firebase Auth UID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160,
          "description": "Verified admin email."
        },
        "role": {
          "type": "string",
          "enum": ["super_admin"],
          "description": "Role label."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when admin marker was created."
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "RtCommunity": {
      "title": "RtCommunity",
      "description": "Server-backed RTQu / Paguyuban workspace with multi-officer (>2) access and server-enforced tenure expiry.",
      "type": "object",
      "properties": {
        "communityId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orgType": {
          "type": "string",
          "enum": ["RT", "Paguyuban", "Organisasi", "Sosial"]
        },
        "customBrandName": {
          "type": "string",
          "maxLength": 80
        },
        "orgName": {
          "type": "string",
          "maxLength": 80
        },
        "areaName": {
          "type": "string",
          "maxLength": 100
        },
        "monthlyDuesAmount": {
          "type": "number"
        },
        "year": {
          "type": "number"
        },
        "inviteCode": {
          "type": "string",
          "maxLength": 32
        },
        "termStartDate": {
          "type": "string",
          "maxLength": 16
        },
        "termEndDate": {
          "type": "string",
          "maxLength": 16
        },
        "termEndTimestamp": {
          "type": "string",
          "format": "date-time"
        },
        "graceEndTimestamp": {
          "type": "string",
          "format": "date-time"
        },
        "gracePeriodDays": {
          "type": "number"
        },
        "skNumber": {
          "type": "string",
          "maxLength": 80
        },
        "officerEmails": {
          "type": "array",
          "description": "Bounded list (1..10) of active board officer verified emails."
        },
        "officers": {
          "type": "array",
          "description": "Bounded list (1..10) of officer role records."
        },
        "kasBalance": {
          "type": "number"
        },
        "totalMasuk": {
          "type": "number"
        },
        "totalKeluar": {
          "type": "number"
        },
        "memberCount": {
          "type": "number"
        },
        "handoverCount": {
          "type": "number"
        },
        "recentTransactions": {
          "type": "array",
          "description": "Bounded snapshot (max 25) of latest kas entries for citizen transparency."
        },
        "handoverHistory": {
          "type": "array",
          "description": "Bounded snapshot (max 15) of Sertijab history."
        },
        "lastGovernanceActionId": {
          "type": "string",
          "maxLength": 128
        },
        "lastActionNote": {
          "type": "string",
          "maxLength": 240
        },
        "createdByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        }
      },
      "required": [
        "communityId",
        "orgType",
        "customBrandName",
        "orgName",
        "areaName",
        "monthlyDuesAmount",
        "year",
        "inviteCode",
        "termStartDate",
        "termEndDate",
        "termEndTimestamp",
        "graceEndTimestamp",
        "gracePeriodDays",
        "skNumber",
        "officerEmails",
        "officers",
        "kasBalance",
        "totalMasuk",
        "totalKeluar",
        "memberCount",
        "handoverCount",
        "recentTransactions",
        "handoverHistory",
        "lastGovernanceActionId",
        "lastActionNote",
        "createdByUid",
        "createdAt",
        "updatedAt",
        "updatedByUid"
      ]
    },
    "RtUidMember": {
      "title": "RtUidMember",
      "description": "Verified citizen membership link keyed by Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "displayName": {
          "type": "string",
          "maxLength": 80
        },
        "inviteCode": {
          "type": "string",
          "maxLength": 32
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "inviteCode", "joinedAt"]
    },
    "RtKasTransaction": {
      "title": "RtKasTransaction",
      "description": "Append-only community treasury transaction record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "type": {
          "type": "string",
          "enum": ["masuk", "keluar"]
        },
        "category": {
          "type": "string",
          "maxLength": 60
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "amount": {
          "type": "number"
        },
        "date": {
          "type": "string",
          "maxLength": 32
        },
        "recordedBy": {
          "type": "string",
          "maxLength": 100
        },
        "recordedByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recordedByEmail": {
          "type": "string",
          "maxLength": 160
        },
        "isCorrection": {
          "type": "boolean"
        },
        "correctsTxId": {
          "type": "string",
          "maxLength": 128
        },
        "termPeriod": {
          "type": "string",
          "maxLength": 40
        },
        "officerEmails": {
          "type": "array",
          "description": "Bounded list (1..10) of board emails for secure list query."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "type",
        "category",
        "title",
        "amount",
        "date",
        "recordedBy",
        "recordedByUid",
        "recordedByEmail",
        "isCorrection",
        "correctsTxId",
        "termPeriod",
        "officerEmails",
        "createdAt"
      ]
    },
    "RtHandoverRecord": {
      "title": "RtHandoverRecord",
      "description": "Immutable Sertijab (Serah Terima Jabatan) archive record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "communityId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "handoverDate": {
          "type": "string",
          "maxLength": 32
        },
        "periodLabel": {
          "type": "string",
          "maxLength": 40
        },
        "outgoingOfficerEmails": {
          "type": "array"
        },
        "incomingOfficerEmails": {
          "type": "array"
        },
        "incomingOfficers": {
          "type": "array"
        },
        "closingBalance": {
          "type": "number"
        },
        "memberCount": {
          "type": "number"
        },
        "skNumber": {
          "type": "string",
          "maxLength": 80
        },
        "note": {
          "type": "string",
          "maxLength": 300
        },
        "officerEmails": {
          "type": "array"
        },
        "approvedByEmails": {
          "type": "array"
        },
        "recordedByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "communityId",
        "handoverDate",
        "periodLabel",
        "outgoingOfficerEmails",
        "incomingOfficerEmails",
        "incomingOfficers",
        "closingBalance",
        "memberCount",
        "skNumber",
        "note",
        "officerEmails",
        "approvedByEmails",
        "recordedByUid",
        "createdAt"
      ]
    },
    "RtGovernanceAction": {
      "title": "RtGovernanceAction",
      "description": "Multi-officer quorum proposal for board update, term extension, or Sertijab handover.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "communityId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actionType": {
          "type": "string",
          "enum": ["update_officers", "extend_term", "sertijab", "collective_recovery"]
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "executed", "rejected"]
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "note": {
          "type": "string",
          "maxLength": 300
        },
        "proposedByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "proposedByEmail": {
          "type": "string",
          "maxLength": 160
        },
        "proposedOfficerEmails": {
          "type": "array"
        },
        "proposedOfficers": {
          "type": "array"
        },
        "proposedTermStartDate": {
          "type": "string",
          "maxLength": 16
        },
        "proposedTermEndDate": {
          "type": "string",
          "maxLength": 16
        },
        "proposedTermEndTimestamp": {
          "type": "string",
          "format": "date-time"
        },
        "proposedGraceEndTimestamp": {
          "type": "string",
          "format": "date-time"
        },
        "proposedGracePeriodDays": {
          "type": "number"
        },
        "proposedSkNumber": {
          "type": "string",
          "maxLength": 80
        },
        "officerEmails": {
          "type": "array"
        },
        "approverEmails": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "communityId",
        "actionType",
        "status",
        "title",
        "note",
        "proposedByUid",
        "proposedByEmail",
        "proposedOfficerEmails",
        "proposedOfficers",
        "proposedTermStartDate",
        "proposedTermEndDate",
        "proposedTermEndTimestamp",
        "proposedGraceEndTimestamp",
        "proposedGracePeriodDays",
        "proposedSkNumber",
        "officerEmails",
        "approverEmails",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/accountRegistry/{uid}": {
      "schema": { "$ref": "#/entities/AccountRegistry" },
      "description": "Lightweight account metadata & module activity per authenticated citizen."
    },
    "/accountPolicies/{policyId}": {
      "schema": { "$ref": "#/entities/AccountPolicy" },
      "description": "Per-account moderation & VIP Free policies managed by Admins."
    },
    "/appConfig/governance": {
      "schema": { "$ref": "#/entities/GovernanceConfig" },
      "description": "Non-PII community free rules (Trah/RT/Paguyuban) managed by Admins."
    },
    "/appConfig/monetization": {
      "schema": { "$ref": "#/entities/MonetizationConfig" },
      "description": "Non-PII modular monetization settings managed by Admins."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Admin lookup table by UID."
    },
    "/rtCommunities/{communityId}": {
      "schema": { "$ref": "#/entities/RtCommunity" },
      "description": "Server-backed RTQu / Paguyuban governance document with multi-officer (>2) roles & tenure lock."
    },
    "/rtCommunities/{communityId}/uidMembers/{uid}": {
      "schema": { "$ref": "#/entities/RtUidMember" },
      "description": "Verified citizen membership link keyed by Auth UID."
    },
    "/rtCommunities/{communityId}/transactions/{txId}": {
      "schema": { "$ref": "#/entities/RtKasTransaction" },
      "description": "Append-only kas ledger entries."
    },
    "/rtCommunities/{communityId}/handovers/{handoverId}": {
      "schema": { "$ref": "#/entities/RtHandoverRecord" },
      "description": "Immutable Sertijab handover history."
    },
    "/rtCommunities/{communityId}/governanceActions/{actionId}": {
      "schema": { "$ref": "#/entities/RtGovernanceAction" },
      "description": "Multi-officer quorum proposals & approvals."
    }
  }
}
